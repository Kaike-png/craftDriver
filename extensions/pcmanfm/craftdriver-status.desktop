# Ação do CraftDriver para PCManFM / PCManFM-Qt (ver craftdriver-menu.desktop).
# ShowIfTrue restringe ao ponto de montagem: só mostra quando TODOS os itens têm o xattr
# user.onedrive.status. O comando imprime "true" (o que a especificação DES-EMA pede) E sai com
# status 0 (o que o libfm-qt de fato confere, via system()); fora do CraftDriver não imprime nada e
# sai com 1. Precisa do getfattr (pacote attr).
[Desktop Entry]
Type=Action
Name=Status no CraftDriver
Tooltip=Mostra o status de sincronização dos itens (CraftDriver)
Icon=help-about
Profiles=craftdriver;

[X-Action-Profile craftdriver]
Name=Status no CraftDriver
MimeTypes=all/all;
TryExec=craftdriver
ShowIfTrue=sh -c 'for f in "$@"; do getfattr --only-values -n user.onedrive.status -- "$f" >/dev/null 2>&1 || exit 1; done; echo true' craftdriver %F
Exec=craftdriver status --notify %F
