<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CraftDriver.App.ViewModels"
        x:Class="CraftDriver.App.Views.ChooseFoldersWindow"
        x:DataType="vm:ChooseFoldersViewModel"
        Title="Escolher pastas — CraftDriver" Width="560" Height="520" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="{Binding DriveName, StringFormat='Pastas sincronizadas — {0}'}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Pastas desmarcadas somem da pasta sincronizada neste computador e nada delas é baixado. Elas continuam na nuvem e voltam ao marcar de novo." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="error"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Classes="accent" Content="Salvar" Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
        <Border Classes="panel" Padding="14,10">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Classes="muted" Text="Esta conta não tem pastas." IsVisible="{Binding !Folders.Count}" />
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderChoiceVm">
                                <CheckBox IsChecked="{Binding Sync}" Content="{Binding Path}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
