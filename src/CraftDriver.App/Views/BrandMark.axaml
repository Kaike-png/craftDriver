<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CraftDriver.App.Views.BrandMark"
             AutomationProperties.AccessibilityView="Raw">
    <!-- o mesmo desenho do ícone do app (packaging/share/icons/.../craftdriver.svg), em vetor para qualquer tamanho -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="64" Height="64">
            <Path Data="M6 16a5 5 0 0 1 5-5h13l5 5h24a5 5 0 0 1 5 5v28a5 5 0 0 1-5 5H11a5 5 0 0 1-5-5z" Fill="#0E8F7E" />
            <Path Data="M42 44H23a6.5 6.5 0 0 1-.9-12.9 9.5 9.5 0 0 1 17.8-2.3A7.6 7.6 0 0 1 42 44z"
                  Stroke="White" StrokeThickness="3.2" StrokeJoin="Round" />
        </Canvas>
    </Viewbox>
</UserControl>
