<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CraftDriver.App.ViewModels"
        x:Class="CraftDriver.App.Views.VersionsWindow"
        x:DataType="vm:VersionsViewModel"
        Title="{Binding FileName, StringFormat='Versões — {0}'}" Width="680" Height="460"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="{Binding FileName, StringFormat='Versões de {0}'}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
            <TextBlock Classes="muted" Text="{Binding FilePath}" TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding FilePath}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <Button Content="Atualizar" Command="{Binding ReloadCommand}" />
                <Button x:Name="CopyButton" Grid.Column="2" Content="Baixar cópia" Margin="8,0" Command="{Binding DownloadCopyCommand}"
                        ToolTip.Tip="Salva essa versão como um arquivo novo ao lado do original" />
                <Button x:Name="RestoreButton" Grid.Column="3" Classes="accent" Content="Restaurar" Command="{Binding RestoreCommand}"
                        ToolTip.Tip="Torna essa versão a atual (as outras versões continuam guardadas)" />
                <Button x:Name="CloseButton" Grid.Column="4" Content="Fechar" IsCancel="True" Margin="8,0,0,0" />
            </Grid>
        </StackPanel>

        <Border Classes="panel">
        <Grid RowDefinitions="Auto,*">
            <Border Classes="table-head">
                <Grid ColumnDefinitions="110,150,90,*">
                    <TextBlock Classes="caption" Text="Versão" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="Modificada em" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="Tamanho" />
                    <TextBlock Grid.Column="3" Classes="caption" Text="Por" />
                </Grid>
            </Border>
            <ListBox x:Name="VersionsList" Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionRowVm">
                        <Grid ColumnDefinitions="110,150,90,*">
                            <TextBlock Text="{Binding Label}" FontWeight="{Binding IsCurrent, Converter={x:Static vm:VersionsWindowConverters.Bold}}" />
                            <TextBlock Grid.Column="1" Text="{Binding When}" />
                            <TextBlock Grid.Column="2" Text="{Binding Size}" />
                            <TextBlock Grid.Column="3" Text="{Binding Author}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Author}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        </Border>
    </DockPanel>
</Window>
