<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CraftDriver.App.ViewModels"
        x:Class="CraftDriver.App.Views.TrashWindow"
        x:DataType="vm:TrashViewModel"
        Title="Lixeira — craftDriver" Width="720" Height="460"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
            <TextBlock Classes="h1" Text="Excluídos recentemente" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Itens que foram para a Lixeira da nuvem. No OneDrive pessoal dá para restaurar daqui; nas contas corporativas e no SharePoint, pela Lixeira no navegador." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Content="Abrir Lixeira no navegador" Command="{Binding OpenInBrowserCommand}" />
                <Button Grid.Column="2" Classes="accent" Content="Restaurar" Margin="8,0" Command="{Binding RestoreCommand}" />
                <Button x:Name="CloseButton" Grid.Column="3" Content="Fechar" IsCancel="True" />
            </Grid>
        </StackPanel>

        <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,170,130,150" Margin="12,0,12,4">
                <TextBlock Classes="muted" Text="Nome" />
                <TextBlock Grid.Column="1" Classes="muted" Text="Pasta sincronizada" />
                <TextBlock Grid.Column="2" Classes="muted" Text="Excluído em" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrashRowVm">
                        <Grid ColumnDefinitions="*,170,130,150">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Drive}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding When}" />
                            <TextBlock Grid.Column="3" Classes="muted" Text="{Binding How}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
