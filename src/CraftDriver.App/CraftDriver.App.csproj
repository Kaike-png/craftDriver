<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Version>0.1.4</Version>
    <!-- O pacote é publicado com trimming (packaging/build.sh): qualquer uso que o trimmer não consiga analisar
         (JSON por reflexão etc.) quebra o build em vez de virar falha em produção. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2090;IL2091;IL2104;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- notificações pelo D-Bus; mesma versão que o Avalonia.FreeDesktop já traz (nenhum pacote novo) -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CraftDriver.UiTests" />
  </ItemGroup>

  <!-- Fonte única dos .desktop: os mesmos arquivos que os pacotes instalam em /usr/share (modo usuário só troca o Exec) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\share\applications\craftdriver.desktop" LogicalName="share/applications/craftdriver.desktop" />
    <EmbeddedResource Include="..\..\packaging\share\kio\servicemenus\craftdriver.desktop" LogicalName="share/kio/servicemenus/craftdriver.desktop" />
    <EmbeddedResource Include="..\..\packaging\share\icons\hicolor\scalable\apps\craftdriver.svg" LogicalName="share/icons/hicolor/scalable/apps/craftdriver.svg" />
    <EmbeddedResource Include="..\..\packaging\share\icons\hicolor\symbolic\apps\craftdriver-symbolic.svg" LogicalName="share/icons/hicolor/symbolic/apps/craftdriver-symbolic.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CraftDriver.Core\CraftDriver.Core.csproj" />
    <ProjectReference Include="..\CraftDriver.Fuse\CraftDriver.Fuse.csproj" />
  </ItemGroup>
</Project>
