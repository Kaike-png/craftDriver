<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CraftDriver.App.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <!-- todos os estilos próprios do app ficam numa fonte só -->
        <StyleInclude Source="avares://CraftDriver.App/Styles/CraftDriverStyles.axaml" />
    </Application.Styles>
</Application>
