[Desktop Entry]
Type=Application
Name=craftDriver
GenericName=Cliente para OneDrive e SharePoint
GenericName[en]=OneDrive and SharePoint client
Comment=Sincroniza OneDrive e SharePoint com arquivos sob demanda
Comment[en]=Sync OneDrive and SharePoint with files on demand
Exec=craftdriver
Icon=craftdriver
Terminal=false
Categories=Network;FileTransfer;
Keywords=OneDrive;SharePoint;Microsoft;cloud;nuvem;sync;
StartupWMClass=CraftDriver.App
Actions=open-folder;sync;pause;resume;

[Desktop Action open-folder]
Name=Abrir pasta
Name[en]=Open folder
Icon=folder-cloud
Exec=craftdriver open

[Desktop Action sync]
Name=Sincronizar agora
Name[en]=Sync now
Icon=view-refresh
Exec=craftdriver sync --notify

[Desktop Action pause]
Name=Pausar sincronização
Name[en]=Pause syncing
Icon=media-playback-pause
Exec=craftdriver pause --notify

[Desktop Action resume]
Name=Retomar sincronização
Name[en]=Resume syncing
Icon=media-playback-start
Exec=craftdriver resume --notify
